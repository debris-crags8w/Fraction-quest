modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[[deployment.scheduled]]
job = "Daily Heart voice backfill"
cron = "0 3 * * *"
timezone = "America/New_York"
timeout = 7200
run = ["pnpm", "--filter", "@workspace/api-server", "run", "daily-voice-backfill"]

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["glib", "nspr", "nss", "dbus", "atk", "at-spi2-core", "cups", "cairo", "gtk3", "pango", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "xorg.libxcb", "libxkbcommon", "alsa-lib", "libgbm"]

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 20785
externalPort = 3001
exposeLocalhost = true

[[ports]]
localPort = 24179
externalPort = 3000
